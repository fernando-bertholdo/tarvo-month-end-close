# Copy to .env and fill in. .env is gitignored: never commit real keys.
# For September (the case month) no key is needed: the versioned cache reproduces saida/.

# Anthropic API key (sent to the jury by e-mail, outside the repository)
TARVO_ANTHROPIC_API_KEY=

# AI port: auto | api | claude-code | nenhuma
TARVO_IA_PORTA=auto

# Model used by both ports
TARVO_IA_MODELO=claude-sonnet-5-5

# Minimum confidence to accept an AI classification (below it: human decision)
TARVO_IA_LIMITE_CONFIANCA=0.80
